{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log"
    },
    // the tests start real rector runs, so a single test takes some seconds
    "timeout": 120,
    "mutators": {
        "@default": true
    },
    "minMsi": 70
}
